#usda 1.0
(
    defaultPrim = "World"
    doc = "Example showing same BifrostGraph_CompoundName used in multiple prims - tests thread safety during parallel composition"
    startTimeCode = 1001
    endTimeCode = 1100
    framesPerSecond = 24
)

def "World"
{
    def "Instance1" (
        payload = @anon:autodesk:bifrost.bifrostDynamicFile@
        references = </DynamicFileFormatField1>
    )
    {
        string name = "geo"
        asset layer_path = @/tmp/helix/helix.usda@
        int count = 4
        token prim_type = "Cylinder"
        float length = 2.0
        #float rotations = 6.0
        #float width = 3.0
        #bool horizontal = 1
        Vec3f translation = (1.0, 2.0, 3.0)

        string BifrostGraph_Options:verbosity_level = "ErrorsOnly"
        bool BifrostGraph_ReloadLibrary = 0
    }

    def "Instance2" (
        payload = @anon:autodesk:bifrost.bifrostDynamicFile@
        references = </DynamicFileFormatField2>
    )
    {
        asset surface_file = @@
        asset prototype_file = @@
        float scatter_radius = 0.57
        float min_instance_scale = 1
        float max_instance_scale = 1
        bool orient_from_surface = 1
        Vec3f rotation_axis_angle = (1, 0, 0)
        bool rotation_enable_randomize = 0
        float rotation_random_factor = 0.25
        int surface_mesh_index = 0
        string surface_mesh_prim_path = ""
        float displacement_factor = 0

        string BifrostGraph_Options:verbosity_level = "ErrorsOnly"
        bool BifrostGraph_ReloadLibrary = 0
    }
}

def "DynamicFileFormatField1" (
    BifrostGraph_CompoundName = "Test::DynamicFileFormat::create_helix_of_prims"
    BifrostGraph_OutputName = "stage"
    BifrostGraph_ReloadLibrary = 0
    BifrostGraph_Options = {
        string verbosity_level = "AllMessages";
    }
    BifrostGraph_Params = {
        string name = "shape"
        string layer_path = ""
        string model_file_path = ""
        bool save = 1
        int count = 2
        token prim_type = "Capsule"
        float length = 1.0
        Vec3f translation = (0.0, 0.0, 0.0)

        #float rotations = 4.0
        #float width = 2.0
        #bool horizontal = 0
    }
)
{
}

def "DynamicFileFormatField2" (
    BifrostGraph_CompoundName = "Test::DynamicFileFormat::scatter_on_surface"
    BifrostGraph_OutputName = "stage"
    BifrostGraph_ReloadLibrary = 0
    BifrostGraph_Options = {
        string verbosity_level = "AllMessages";
    }
    BifrostGraph_Params = {
        string surface_file = ""
        string prototype_file = ""
        float scatter_radius = 0.57
        float min_instance_scale = 1
        float max_instance_scale = 1
        bool orient_from_surface = 1
        Vec3f rotation_axis_angle = (1, 0, 0)
        bool rotation_enable_randomize = 0
        float rotation_random_factor = 0.25
        int surface_mesh_index = 0
        string surface_mesh_prim_path = ""
        float displacement_factor = 0
    }
)
{
}
