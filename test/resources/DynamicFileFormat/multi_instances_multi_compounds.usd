#usda 1.0
(
    defaultPrim = "World"
    doc = "Example showing same BifrostGraph_CompoundName used in multiple prims - tests thread safety during parallel composition"
    startTimeCode = 1001
    endTimeCode = 1100
    framesPerSecond = 24
)

def "World"
{
    def "Instance1" (
        payload = @anon:autodesk:bifrost.bifrostDynamicFile@
        references = </DynamicFileFormatField1>
    )
    {
        string bifrost:in:name = "geo"
        asset bifrost:in:layer_path = @/tmp/helix/helix.usda@
        int bifrost:in:count = 4
        token bifrost:in:prim_type = "Cylinder"
        float bifrost:in:length = 2.0
        Vec3f bifrost:in:translation = (1.0, 2.0, 3.0)

        string bifrost:setting:verbosityLevel = "ErrorsOnly"
        bool bifrost:setting:reloadLibrary = false
    }

    def "Instance2" (
        payload = @anon:autodesk:bifrost.bifrostDynamicFile@
        references = </DynamicFileFormatField2>
    )
    {
        asset bifrost:in:surface_file = @@
        asset bifrost:in:prototype_file = @@
        float bifrost:in:scatter_radius = 0.57
        float bifrost:in:min_instance_scale = 1
        float bifrost:in:max_instance_scale = 1
        bool bifrost:in:orient_from_surface = 1
        Vec3f bifrost:in:rotation_axis_angle = (1, 0, 0)
        bool bifrost:in:rotation_enable_randomize = 0
        float bifrost:in:rotation_random_factor = 0.25
        int bifrost:in:surface_mesh_index = 0
        string bifrost:in:surface_mesh_prim_path = ""
        float bifrost:in:displacement_factor = 0

        string bifrost:setting:verbosityLevel = "ErrorsOnly"
        bool bifrost:setting:reloadLibrary = false
    }
}

def "DynamicFileFormatField1" (
    bifrostCompound = {
        string name = "Test::DynamicFileFormat::create_helix_of_prims"
    }
    bifrostInputs = {
        string name = "shape"
        asset layer_path = ""
        string model_file_path = ""
        bool save = 1
        int count = 2
        token prim_type = "Capsule"
        float length = 1.0
        Vec3f translation = (0.0, 0.0, 0.0)
    }
    bifrostOutputs = ["stage"]
    bifrostSettings = {
        string verbosityLevel = "AllMessages";
        bool reloadLibrary = false
    }
)
{
}

def "DynamicFileFormatField2" (
    bifrostCompound = {
        string name = "Test::DynamicFileFormat::scatter_on_surface"
    }
    bifrostInputs = {
        asset surface_file = ""
        asset prototype_file = ""
        float scatter_radius = 0.57
        float min_instance_scale = 1
        float max_instance_scale = 1
        bool orient_from_surface = 1
        Vec3f rotation_axis_angle = (1, 0, 0)
        bool rotation_enable_randomize = 0
        float rotation_random_factor = 0.25
        int surface_mesh_index = 0
        string surface_mesh_prim_path = ""
        float displacement_factor = 0
    }
    bifrostOutputs = ["stage"]
    bifrostSettings = {
        string verbosityLevel = "AllMessages";
        bool reloadLibrary = false
    }
)
{
}
