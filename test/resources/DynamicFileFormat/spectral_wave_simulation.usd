#usda 1.0
(
    defaultPrim = "Root"
    startTimeCode = 1001
    endTimeCode = 1100
    framesPerSecond = 24
)

def "Root" (
    payload = @anon:autodesk:bifrost.bifrostDynamicFile@
    references = </DynamicFileFormatField>
)
{
    double BifrostGraph_Globals:timeline_info_start_frame = 1001
    double BifrostGraph_Globals:timeline_info_end_frame = 1100
    string BifrostGraph_Options:verbosity_level = "ErrorsOnly"
    bool BifrostGraph_ReloadLibrary = 0
    float length = 100
    int segments = 500
    float spectral_wave_height = 2
    float spectral_wave_ocean_depth = 10
    int spectral_wave_resolution = 256
    float spectral_wave_space_scale = 0.95
    float spectral_wave_speed_scale = 1
    float width = 100
}

def "DynamicFileFormatField" (
    BifrostGraph_CompoundName = "Test::DynamicFileFormat::spectral_wave_simulation"
    BifrostGraph_Globals = {
        double time_fps = 24
        double timeline_info_start_frame = 1
        double timeline_info_end_frame = 100
    }
    BifrostGraph_OutputName = "geometry_with_material"
    BifrostGraph_Params = {
        float length = 100
        int segments = 100
        float spectral_wave_height = 2
        float spectral_wave_ocean_depth = 10
        int spectral_wave_resolution = 256
        float spectral_wave_space_scale = 1
        float spectral_wave_speed_scale = 1
        float width = 100
    }
)
{
}
