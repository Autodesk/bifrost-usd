#usda 1.0
(
    defaultPrim = "World"
    doc = "Example showing same BifrostGraph_CompoundName used in multiple prims - tests thread safety during parallel composition"
    startTimeCode = 1001
    endTimeCode = 1100
    framesPerSecond = 24
)

def "World"
{
    def "Instance1" (
        payload = @anon:autodesk:bifrost.bifrostDynamicFile@
        references = </DynamicFileFormatField1>
    )
    {
        double BifrostGraph_Globals:timeline_info_end_frame = 1100
        double BifrostGraph_Globals:timeline_info_start_frame = 1001
        string BifrostGraph_Options:verbosity_level = "ErrorsOnly"
        bool BifrostGraph_ReloadLibrary = 0
        float length = 50
        int segments = 100
        float spectral_wave_height = 2
        float spectral_wave_ocean_depth = 10
        int spectral_wave_resolution = 128
        float spectral_wave_space_scale = 0.95
        float spectral_wave_speed_scale = 1
        float width = 50
    }

    def "Instance2" (
        payload = @anon:autodesk:bifrost.bifrostDynamicFile@
        references = </DynamicFileFormatField2>
    )
    {
        double BifrostGraph_Globals:timeline_info_end_frame = 1100
        double BifrostGraph_Globals:timeline_info_start_frame = 1001
        string BifrostGraph_Options:verbosity_level = "ErrorsOnly"
        bool BifrostGraph_ReloadLibrary = 0
        float length = 100
        int segments = 200
        float spectral_wave_height = 4
        float spectral_wave_ocean_depth = 20
        int spectral_wave_resolution = 256
        float spectral_wave_space_scale = 1.2
        float spectral_wave_speed_scale = 1.5
        float width = 100
    }
}

def "DynamicFileFormatField1" (
    BifrostGraph_CompoundName = "Test::DynamicFileFormat::spectral_wave_simulation"
    BifrostGraph_Globals = {
        double time_fps = 24
        double timeline_info_end_frame = 100
        double timeline_info_start_frame = 1
    }
    BifrostGraph_OutputName = "geometry_with_material"
    BifrostGraph_Params = {
        float length = 50
        int segments = 100
        float spectral_wave_height = 2
        float spectral_wave_ocean_depth = 10
        int spectral_wave_resolution = 128
        float spectral_wave_space_scale = 0.95
        float spectral_wave_speed_scale = 1
        float width = 50
    }
)
{
}

def "DynamicFileFormatField2" (
    BifrostGraph_CompoundName = "Test::DynamicFileFormat::spectral_wave_simulation"
    BifrostGraph_Globals = {
        double time_fps = 24
        double timeline_info_end_frame = 100
