#usda 1.0
(
    defaultPrim = "World"
    doc = "Example showing same BifrostGraph_CompoundName used in multiple prims - tests thread safety during parallel composition"
    startTimeCode = 1001
    endTimeCode = 1100
    framesPerSecond = 24
)

def "World"
{
    def "Instance1" (
        payload = @anon:autodesk:bifrost.bifrostDynamicFile@
        references = </DynamicFileFormatField1>
    )
    {
        float bifrost:in:length = 50
        int bifrost:in:segments = 100
        float bifrost:in:spectral_wave_height = 2
        float bifrost:in:spectral_wave_ocean_depth = 10
        int bifrost:in:spectral_wave_resolution = 128
        float bifrost:in:spectral_wave_space_scale = 0.95
        float bifrost:in:spectral_wave_speed_scale = 1
        float bifrost:in:width = 50

        double bifrost:global:timeline_info_end_frame = 1100
        double bifrost:global:timeline_info_start_frame = 1001

        string bifrost:setting:verbosityLevel = "ErrorsOnly"
        bool bifrost:setting:reloadLibrary = false
    }

    def "Instance2" (
        payload = @anon:autodesk:bifrost.bifrostDynamicFile@
        references = </DynamicFileFormatField2>
    )
    {
        float bifrost:in:length = 100
        int bifrost:in:segments = 200
        float bifrost:in:spectral_wave_height = 4
        float bifrost:in:spectral_wave_ocean_depth = 20
        int bifrost:in:spectral_wave_resolution = 256
        float bifrost:in:spectral_wave_space_scale = 1.2
        float bifrost:in:spectral_wave_speed_scale = 1.5
        float bifrost:in:width = 100

        double bifrost:global:timeline_info_end_frame = 1100
        double bifrost:global:timeline_info_start_frame = 1001

        string bifrost:setting:verbosityLevel = "ErrorsOnly"
        bool bifrost:setting:reloadLibrary = false
    }
}

def "DynamicFileFormatField1" (
    bifrostCompound = {
        string name = "Test::DynamicFileFormat::spectral_wave_simulation"
    }
    bifrostInputs = {
        float length = 50
        int segments = 100
        float spectral_wave_height = 2
        float spectral_wave_ocean_depth = 10
        int spectral_wave_resolution = 128
        float spectral_wave_space_scale = 0.95
        float spectral_wave_speed_scale = 1
        float width = 50
    }
    bifrostGlobals = {
        double time_fps = 24
        double timeline_info_end_frame = 100
        double timeline_info_start_frame = 1
    }
    bifrostOutputs = ["geometry_with_material"]
)
{
}

def "DynamicFileFormatField2" (
    bifrostCompound = {
        string name = "Test::DynamicFileFormat::spectral_wave_simulation"
    }
    bifrostInputs = {
        float length = 100
        int segments = 200
        float spectral_wave_height = 4
        float spectral_wave_ocean_depth = 20
        int spectral_wave_resolution = 256
        float spectral_wave_space_scale = 1.2
        float spectral_wave_speed_scale = 1.5
        float width = 100
    }
    bifrostGlobals = {
        double time_fps = 24
        double timeline_info_end_frame = 100
        double timeline_info_start_frame = 1
    }
    bifrostOutputs = ["geometry_with_material"]
)
{
}
