#usda 1.0
(
    defaultPrim = "Root"

    #
    # USD stage playback range — used by USD viewers (usdview, etc.) to set
    # the timeline slider. Not read by Bifrost nor by BifrostDynamicFileFormat:
    #
    startTimeCode = 2
    endTimeCode = 10
)

def "Root" (
    references = </DynamicFileFormatField>
    payload = @anon:autodesk:bifrost.bifrostDynamicFile@
)
{
    string bifrost:setting:verbosityLevel = "ErrorsOnly"
    bool bifrost:setting:reloadLibrary = false

    #
    # Effective bifrostGlobals timeline values.
    # Bifrost graph gets these Root's authored opinions.
    # Therefore, Bifrost generates only samples for this time range:
    #
    double bifrost:global:timeline_info_start_frame = 1
    double bifrost:global:timeline_info_end_frame = 5
}

def "DynamicFileFormatField" (
    bifrostCompound = {
        string name = "Test::DynamicFileFormat::animated_mesh_deformed"
    }
    bifrostInputs = {
    }
    bifrostOutputs = ["out_stage"]
    bifrostSettings = {
        bool reloadLibrary = false
        string verbosityLevel = "AllMessages"
    }

    #
    # Default bifrostGlobals timeline values.
    # These are overwritten by the bifrostGlobals attributes on Root above.
    #
    bifrostGlobals = {
        double timeline_info_start_frame = 1000
        double timeline_info_end_frame = 1010
    }
)
{
}
