#usda 1.0
(
    defaultPrim = "Root"
    startTimeCode = 0
    endTimeCode = 0
)

def "Root" (
    references = </DynamicFileFormatField>
    payload = @anon:autodesk:bifrost.bifrostDynamicFile@
)
{
    string bifrost:setting:verbosityLevel = "ErrorsOnly"
    bool bifrost:setting:reloadLibrary = false
}

def "DynamicFileFormatField" (
    bifrostCompound = {
        string name = "Test::DynamicFileFormat::boolean_fracture_usd_meshes"
    }
    bifrostInputs = {
        string file = ""
        bool generate_slicer_planes = true
        Vec3i slicer_plane_count = (0, 2, 0)
        int random_seed = 0
        float orientation_spread = 0.5
        bool apply_displacement = false
        float expand_amount = 1.5
        bool display_planes = false
    }
    bifrostGlobals = {
    }
    bifrostOutputs = ["shards"]
    bifrostSettings = {
        string verbosityLevel = "AllMessages"
        bool reloadLibrary = false
    }
)
{
}
