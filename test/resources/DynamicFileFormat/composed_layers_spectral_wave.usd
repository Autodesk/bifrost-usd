#usda 1.0
(
    subLayers = [@./base_layer_spectral_wave.usd@]
    defaultPrim = "Instance2"
    doc = "Layer composition example - sublayers base_layer_spectral_wave.usd and adds Instance2 with same compound"
    startTimeCode = 1001
    endTimeCode = 1100
    framesPerSecond = 24
)

def "Instance2" (
    payload = @anon:autodesk:bifrost.bifrostDynamicFile@
    references = </DynamicFileFormatField2>
)
{
    float bifrost:in:length = 120
    int bifrost:in:segments = 300
    float bifrost:in:spectral_wave_height = 5
    float bifrost:in:spectral_wave_ocean_depth = 15
    int bifrost:in:spectral_wave_resolution = 512
    float bifrost:in:spectral_wave_space_scale = 1.1
    float bifrost:in:spectral_wave_speed_scale = 1.3
    float bifrost:in:width = 120

    double bifrost:global:timeline_info_end_frame = 1100
    double bifrost:global:timeline_info_start_frame = 1001

    string bifrost:setting:verbosityLevel = "ErrorsOnly"
    bool bifrost:setting:reloadLibrary = false
}

def "DynamicFileFormatField2" (
    bifrostCompound = {
        string name = "Test::DynamicFileFormat::spectral_wave_simulation"
    }
    bifrostInputs = {
        float length = 120
        int segments = 300
        float spectral_wave_height = 5
        float spectral_wave_ocean_depth = 15
        int spectral_wave_resolution = 512
        float spectral_wave_space_scale = 1.1
        float spectral_wave_speed_scale = 1.3
        float width = 120
    }
    bifrostGlobals = {
        double time_fps = 24
        double timeline_info_end_frame = 100
        double timeline_info_start_frame = 1
    }
    bifrostOutputs = ["geometry_with_material"]
)
{
}
