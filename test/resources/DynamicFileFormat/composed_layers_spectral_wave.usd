#usda 1.0
(
    subLayers = [@./base_layer_spectral_wave.usd@]
    defaultPrim = "Instance2"
    doc = "Layer composition example - sublayers base_layer_spectral_wave.usd and adds Instance2 with same compound"
    startTimeCode = 1001
    endTimeCode = 1100
    framesPerSecond = 24
)

def "Instance2" (
    payload = @anon:autodesk:bifrost.bifrostDynamicFile@
    references = </DynamicFileFormatField2>
)
{
    double BifrostGraph_Globals:timeline_info_end_frame = 1100
    double BifrostGraph_Globals:timeline_info_start_frame = 1001
    string BifrostGraph_Options:verbosity_level = "ErrorsOnly"
    bool BifrostGraph_ReloadLibrary = 0
    float length = 120
    int segments = 300
    float spectral_wave_height = 5
    float spectral_wave_ocean_depth = 15
    int spectral_wave_resolution = 512
    float spectral_wave_space_scale = 1.1
    float spectral_wave_speed_scale = 1.3
    float width = 120
}

def "DynamicFileFormatField2" (
    BifrostGraph_CompoundName = "Test::DynamicFileFormat::spectral_wave_simulation"
    BifrostGraph_Globals = {
        double time_fps = 24
        double timeline_info_end_frame = 100
        double timeline_info_start_frame = 1
    }
    BifrostGraph_OutputName = "geometry_with_material"
    BifrostGraph_Params = {
        float length = 120
        int segments = 300
        float spectral_wave_height = 5
        float spectral_wave_ocean_depth = 15
        int spectral_wave_resolution = 512
        float spectral_wave_space_scale = 1.1
        float spectral_wave_speed_scale = 1.3
        float width = 120
    }
)
{
}
