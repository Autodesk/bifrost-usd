#usda 1.0
(
    doc = "Base layer example - can be composed with other layers that also use the same BifrostGraph_CompoundName"
    startTimeCode = 1001
    endTimeCode = 1100
    framesPerSecond = 24
)

def "Instance1" (
    payload = @anon:autodesk:bifrost.bifrostDynamicFile@
    references = </DynamicFileFormatField>
)
{
    float bifrost:in:length = 80
    int bifrost:in:segments = 150
    float bifrost:in:spectral_wave_height = 2
    float bifrost:in:spectral_wave_ocean_depth = 10
    int bifrost:in:spectral_wave_resolution = 256
    float bifrost:in:spectral_wave_space_scale = 0.95
    float bifrost:in:spectral_wave_speed_scale = 1
    float bifrost:in:width = 80

    double bifrost:global:timeline_info_end_frame = 1100
    double bifrost:global:timeline_info_start_frame = 1001

    string bifrost:setting:verbosityLevel = "ErrorsOnly"
    bool bifrost:setting:reloadLibrary = false
}

def "DynamicFileFormatField" (
    bifrostCompound = {
        string name = "Test::DynamicFileFormat::spectral_wave_simulation"
    }
    bifrostInputs = {
        float length = 80
        int segments = 150
        float spectral_wave_height = 2
        float spectral_wave_ocean_depth = 10
        int spectral_wave_resolution = 256
        float spectral_wave_space_scale = 0.95
        float spectral_wave_speed_scale = 1
        float width = 80
    }
    bifrostGlobals = {
        double time_fps = 24
        double timeline_info_end_frame = 100
        double timeline_info_start_frame = 1
    }
    bifrostOutputs = ["geometry_with_material"]
)
{
}
