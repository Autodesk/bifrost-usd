#usda 1.0

# In usdview you can change the parameters of the Bifrost graph like this:
#
# usdviewApi.prim.SetMetadataByDictKey("BifrostGraph_Params", "count", 12)
# usdviewApi.prim.SetMetadataByDictKey("BifrostGraph_Params", "prim_type", "Sphere")
# usdviewApi.prim.SetMetadataByDictKey("BifrostGraph_Params", "prim_type", "Sphere")
# usdviewApi.prim.SetMetadataByDictKey("BifrostGraph_Params", "length", 2)
# usdviewApi.prim.SetMetadataByDictKey("BifrostGraph_Params", "rotations", 6)
# usdviewApi.prim.SetMetadataByDictKey("BifrostGraph_Params", "width", 3)
# usdviewApi.prim.SetMetadataByDictKey("BifrostGraph_Params", "horizontal", 1)

def "Root" (
    references = </DynamicFileFormatField>
    payload = @anon:autodesk:bifrost.bifrostDynamicFile@
)
{
    string name = "geo"
    asset layer_path = @/tmp/helix/helix.usda@
    int count = 4
    token prim_type = "Cylinder"
    float length = 2.0
    #float rotations = 6.0
    #float width = 3.0
    #bool horizontal = 1
    Vec3f translation = (1.0, 2.0, 3.0)

    string BifrostGraph_Options:verbosity_level = "ErrorsOnly"
    bool BifrostGraph_ReloadLibrary = 0
}

def "DynamicFileFormatField" (
    BifrostGraph_CompoundName = "Test::DynamicFileFormat::create_helix_of_prims"
    BifrostGraph_OutputName = "stage"
    BifrostGraph_ReloadLibrary = 0
    BifrostGraph_Options = {
        string verbosity_level = "AllMessages";
    }
    BifrostGraph_Params = {
        string name = "shape"
        string layer_path = ""
        string model_file_path = ""
        bool save = 1
        int count = 2
        token prim_type = "Capsule"
        float length = 1.0
        Vec3f translation = (0.0, 0.0, 0.0)

        #float rotations = 4.0
        #float width = 2.0
        #bool horizontal = 0
    }
)
{
}
