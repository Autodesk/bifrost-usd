#usda 1.0

def "Root" (
    references = </DynamicFileFormatField>
    payload = @anon:autodesk:bifrost.bifrostDynamicFile@
)
{
    asset surface_file = @@
    asset prototype_file = @@
    float scatter_radius = 0.57
    float min_instance_scale = 1
    float max_instance_scale = 1
    bool orient_from_surface = 1
    Vec3f rotation_axis_angle = (1, 0, 0)
    bool rotation_enable_randomize = 0
    float rotation_random_factor = 0.25
    int surface_mesh_index = 0
    string surface_mesh_prim_path = ""
    float displacement_factor = 0

    string BifrostGraph_Options:verbosity_level = "ErrorsOnly"
    bool BifrostGraph_ReloadLibrary = 0

}

def "DynamicFileFormatField" (
    BifrostGraph_CompoundName = "Test::DynamicFileFormat::scatter_on_surface"
    BifrostGraph_OutputName = "stage"
    BifrostGraph_ReloadLibrary = 0
    BifrostGraph_Options = {
        string verbosity_level = "AllMessages";
    }
    BifrostGraph_Params = {
        string surface_file = ""
        string prototype_file = ""
        float scatter_radius = 0.57
        float min_instance_scale = 1
        float max_instance_scale = 1
        bool orient_from_surface = 1
        Vec3f rotation_axis_angle = (1, 0, 0)
        bool rotation_enable_randomize = 0
        float rotation_random_factor = 0.25
        int surface_mesh_index = 0
        string surface_mesh_prim_path = ""
        float displacement_factor = 0
    }
)
{
}
