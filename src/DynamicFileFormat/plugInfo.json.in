{
    "Plugins": [
        {
            "LibraryPath": "@BIFROST_DFF_REL_SHARED_LIB_DIR@/@CMAKE_SHARED_MODULE_PREFIX@BifrostUsdDynamicFileFormat_@BIFUSD_MAJOR_VERSION@_@BIFUSD_MINOR_VERSION@@CMAKE_SHARED_MODULE_SUFFIX@",
            "Name": "bifrostDynamicFileFormat",
            "ResourcePath": ".",
            "Root": "..",
            "Type": "library",
            "Info": {
                "Types": {
                    "BifrostDynamicFileFormat": {
                        "bases": [
                            "SdfFileFormat"
                        ],
                        "displayName": "Bifrost Dynamic File Format",
                        "extensions": [
                            "bifrostDynamicFile"
                        ],
                        "formatId": "bifrostDynamicFile",
                        "primary": true,
                        "target": "usd"
                    }
                },
                "SdfMetadata": {
                    "bifrostCompound": {
                        "type": "dictionary",
                        "displayGroup": "Core",
                        "appliesTo": ["prims"],
                        "documentation:": "The Bifrost compound to execute."
                    },
                    "bifrostGlobals": {
                        "type": "dictionary",
                        "displayGroup": "Core",
                        "appliesTo": ["prims"],
                        "documentation:": "The global variables consumed by the Bifrost graph at execution time."
                    },
                    "bifrostInputs": {
                        "type": "dictionary",
                        "displayGroup": "Core",
                        "appliesTo": ["prims"],
                        "documentation:": "The input port values for the Bifrost compound to execute."
                    },
                    "bifrostOutputs": {
                        "type": "token[]",
                        "displayGroup": "Core",
                        "appliesTo": ["prims"],
                        "documentation:": "The names of the Bifrost compound output ports to evaluate when generating the USD layer content.\nNote: only the first declared output port is currently evaluated."
                    },
                    "bifrostSettings": {
                        "type": "dictionary",
                        "displayGroup": "Core",
                        "appliesTo": ["prims"],
                        "documentation:": "Execution settings that control the Bifrost graph evaluation behavior."
                    }
                }
            }
        }
    ]
}
