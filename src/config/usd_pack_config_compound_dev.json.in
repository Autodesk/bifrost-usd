{
    "AminoConfigurations": [
        {
            "vendorName": "Autodesk",
            "libraryName": "@BIFUSD_PACKAGE_NAME@",
            "libraryVersion": "@BIFUSD_MAJOR_VERSION@.@BIFUSD_MINOR_VERSION@.@BIFUSD_PATCH_LEVEL@",
            "sharedLibs": [
                {
                    "path": "${BIFROST_USD_CONFIG_SHARED_LIB}",
                    "files": [
                        "BifrostUSD_@BIFUSD_MAJOR_VERSION@_@BIFUSD_MINOR_VERSION@",
                        "BifrostUSDNodedefs_@BIFUSD_MAJOR_VERSION@_@BIFUSD_MINOR_VERSION@"
                    ]
                }
            ],
            "jsonLibs": [
                {
                    "path": "${BIFROST_USD_CONFIG_JSON}"
                },
                {
                    "path": "${USD_SRC_COMPOUND_DEV_COMPOUNDS}"
                },
                {
                    "path": "${USD_SRC_COMPOUND_DEV_GRAPHS}"
                },
                {
                    "path": "${USD_SRC_COMPOUND_DEV_TEST_ROOT}/compounds"
                }
            ],
            "watchPointsTranslationLibs": [
                {
                    "path": "${BIFROST_USD_CONFIG_SHARED_LIB}",
                    "files": [
                        "BifrostUSDWatchpoint_@BIFUSD_MAJOR_VERSION@_@BIFUSD_MINOR_VERSION@"
                    ]
                }
            ]
        }
    ],
    "include":  "${USD_SRC_COMPOUND_DEV_CONFIG}"
}
